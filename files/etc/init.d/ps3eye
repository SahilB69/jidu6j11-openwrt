#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG="/usr/bin/ustreamer"

start_service() {
	config_load ps3eye

	local enabled device host port resolution fps quality workers format
	config_get_bool enabled settings enabled 1
	config_get device settings device '/dev/video0'
	config_get host settings host '0.0.0.0'
	config_get port settings port '8080'
	config_get resolution settings resolution '640x480'
	config_get fps settings fps '15'
	config_get quality settings quality '80'
	config_get workers settings workers '2'
	config_get format settings format 'YUYV'

	[ "$enabled" -eq 1 ] || return 0

	if [ ! -c "$device" ]; then
		logger -t ps3eye "Notice: Video device $device not present. Service will start via hotplug when camera is attached."
		return 0
	fi

	procd_open_instance ps3eye
	procd_set_param command "$PROG" \
		--device="$device" \
		--host="$host" \
		--port="$port" \
		--resolution="$resolution" \
		--desired-fps="$fps" \
		--quality="$quality" \
		--workers="$workers" \
		--format="$format"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	logger -t ps3eye "Stopping PS3 Eye streamer service"
}
