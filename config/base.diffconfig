# Target
CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq95xx=y
CONFIG_TARGET_MULTI_PROFILE=y

# All six SKUs. Profile names must match "define Device/<name>" in
# target/linux/qualcommbe/image/ipq95xx.mk - adjust if yours differ.
CONFIG_TARGET_DEVICE_qualcommbe_ipq95xx_DEVICE_jiorouter_ax6000-jidu6j11-6111=y
CONFIG_TARGET_DEVICE_qualcommbe_ipq95xx_DEVICE_jiorouter_ax6000-jidu6j11-6411=y
CONFIG_TARGET_DEVICE_qualcommbe_ipq95xx_DEVICE_jiorouter_ax6000-jidu6j11-6611=y
CONFIG_TARGET_DEVICE_qualcommbe_ipq95xx_DEVICE_jiorouter_ax6000-jidu6j11-6711=y
CONFIG_TARGET_DEVICE_qualcommbe_ipq95xx_DEVICE_jiorouter_ax6000-jidu6j11-6811=y
CONFIG_TARGET_DEVICE_qualcommbe_ipq95xx_DEVICE_jiorouter_ax6000-jidu6j11-6911=y

# Common packages baked into every image
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
